# PostgreSQL (Neon recommended). DIRECT_URL is the unpooled connection for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js v5
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Public site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob (optional — resume upload UI degrades gracefully without this)
BLOB_READ_WRITE_TOKEN=""

# Seeded employee admin (used by `npx prisma db seed`)
SEED_ADMIN_EMAIL="admin@twinlink.example"
SEED_ADMIN_PASSWORD="ChangeMeNow!"
